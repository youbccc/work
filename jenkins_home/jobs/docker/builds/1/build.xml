    <result>SUCCESS</result>
    <script>pipeline {
    agent any

    stages {
        stage(&apos;1. GitHub 소스코드 가져오기&apos;) {
            steps {
                // 본인의 GitHub 저장소 주소로 변경하세요
                git branch: &apos;main&apos;, url: &apos;https://github.com/youbccc/work.git&apos;
            }
        }

        stage(&apos;2. 기존 컨테이너 정리&apos;) {
            steps {
                // 이미 실행 중인 컨테이너가 있다면 중지 및 삭제 (오류 방지용 || true)
                sh &apos;docker stop my-app-container || true&apos;
                sh &apos;docker rm my-app-container || true&apos;
            }
        }

        stage(&apos;3. Dockerfile 기반 이미지 빌드&apos;) {
            steps {
                // Git에서 가져온 Dockerfile을 빌드
                sh &apos;docker build -t my-work-image:latest .&apos;
            }
        }

        stage(&apos;4. 새 컨테이너 실행 (배포)&apos;) {
            steps {
                // 빌드된 이미지로 새 컨테이너 실행
                sh &apos;docker run -d --name my-app-container my-work-image:latest&apos;
            }
        }
    }
}</script>
